{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd web && npm run build",
  "devCommand": "cd web && npm run dev",
  "installCommand": "cd web && npm ci",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/cron/account-deletion",
      "schedule": "17 2 * * *"
    }
  ]
}