@app.post("/api/v1/text-to-cad", response_model=TextToCadResponse)
async def text_to_cad(request: TextToCadRequest):
    """Convert natural language to 3D CAD model."""
    try:
        # Parse natural language
        parse_result = parse_natural_language(request.text)
        
        if not parse_result.success or not parse_result.spec:
            return TextToCadResponse(
                success=False,
                error=parse_result.error or "Failed to parse description",
                validationErrors=[],
            )
        
        part_spec = parse_result.spec
        part_spec.unit_system = UnitSystem(request.unitSystem)
        
        # Validate spec
        spec_errors = validate_spec(part_spec)
        if spec_errors:
            return TextToCadResponse(
                success=False,
                error="Specification validation failed",
                validationErrors=spec_errors,
            )
        
        # Generate geometry
        part = create_part_from_spec(part_spec)
        
        # Validate geometry
        geom_errors = validate_geometry(part)
        if geom_errors:
            return TextToCadResponse(
                success=False,
                error="Geometry validation failed",
                validationErrors=geom_errors,
            )
        
        # Export to requested formats
        step_b64 = None
        stl_b64 = None
        
        if "step" in request.exportFormats:
            step_result: ExportResult = export_step(part)
            if step_result.success and step_result.data:
                step_b64 = base64.b64encode(step_result.data).decode()
        
        if "stl" in request.exportFormats:
            stl_result: ExportResult = export_stl(part)
            if stl_result.success and stl_result.data:
                stl_b64 = base64.b64encode(stl_result.data).decode()
        
        return TextToCadResponse(
            success=True,
            partSpec=part_spec.model_dump(mode="json"),
            stepBase64=step_b64,
            stlBase64=stl_b64,
        )
        
    except Exception as e:
        traceback.print_exc()
        return TextToCadResponse(
            success=False,
            error=f"Generation failed: {str(e)}",
        )


