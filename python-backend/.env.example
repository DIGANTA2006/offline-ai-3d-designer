# =============================================================================
# Offline AI 3D Designer - Python CAD Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
APP_ENV=development
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# CORS Origins (comma-separated)
# Add your Vercel frontend URL(s) here
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CAD_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Optional drawing vision-language model (strict schema + JSON-mode compatibility fallback)
#
# Ollama (local, or an Ollama server reachable from the backend):
#   DRAWING_VISION_PROVIDER=ollama
#   DRAWING_VISION_URL=http://127.0.0.1:11434
#   DRAWING_VISION_MODEL=qwen2.5vl:7b
#
# OpenAI-compatible vision endpoint (provider must support image input + strict
# response_format=json_schema):
#   DRAWING_VISION_PROVIDER=openai_compatible
#   DRAWING_VISION_URL=https://your-provider.example/v1
#   DRAWING_VISION_MODEL=your-vision-model
#   DRAWING_VISION_API_KEY=  # keep secret; never use a NEXT_PUBLIC variable
#   DRAWING_VISION_TIMEOUT_SECONDS=110  # allowed range: 1..600 seconds
#
# For Railway, the URL must be reachable from the Railway container; localhost
# refers to Railway itself, not your laptop. If these are unset, the service
# falls back to conservative explicit-label extraction with no visual reasoning.
# -----------------------------------------------------------------------------
# DRAWING_VISION_PROVIDER=ollama
# DRAWING_VISION_URL=http://127.0.0.1:11434
# DRAWING_VISION_MODEL=qwen2.5vl:7b
# DRAWING_VISION_API_KEY=
# DRAWING_VISION_TIMEOUT_SECONDS=110

# -----------------------------------------------------------------------------
# Optional: Redis for job queue (Phase 3+)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional: S3-compatible storage for generated files (Phase 3+)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=cad-outputs
# S3_ENDPOINT_URL=  # For MinIO/R2/etc.

# -----------------------------------------------------------------------------
# Optional: OCR API Keys (Phase 3+)
# -----------------------------------------------------------------------------
# TESSERACT_PATH=/usr/bin/tesseract
# OPENAI_API_KEY=  # For GPT-4V vision
# GOOGLE_VISION_API_KEY=
