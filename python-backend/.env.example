# =============================================================================
# Offline AI 3D Designer - Python CAD Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
APP_ENV=development
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# CORS Origins (comma-separated)
# Add your Vercel frontend URL(s) here
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CAD_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Optional drawing vision-language model (JSON-schema output via Ollama)
#
# For local development, uncomment DRAWING_VISION_URL if Ollama is listening here.
# For Railway, this URL must be reachable from the Railway container; localhost
# refers to Railway itself, not your laptop. Keep it unset to use conservative
# explicit-label extraction without visual semantic interpretation.
# -----------------------------------------------------------------------------
# DRAWING_VISION_URL=http://127.0.0.1:11434
# DRAWING_VISION_MODEL=qwen2.5vl:7b

# -----------------------------------------------------------------------------
# Optional: Redis for job queue (Phase 3+)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional: S3-compatible storage for generated files (Phase 3+)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=cad-outputs
# S3_ENDPOINT_URL=  # For MinIO/R2/etc.

# -----------------------------------------------------------------------------
# Optional: OCR API Keys (Phase 3+)
# -----------------------------------------------------------------------------
# TESSERACT_PATH=/usr/bin/tesseract
# OPENAI_API_KEY=  # For GPT-4V vision
# GOOGLE_VISION_API_KEY=
