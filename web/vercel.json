{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/account-deletion",
      "schedule": "17 2 * * *"
    }
  ]
}
