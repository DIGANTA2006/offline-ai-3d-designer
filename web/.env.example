# =============================================================================
# Offline AI 3D Designer - Web Frontend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Client (Public - safe to expose in browser)
# Get from Firebase Console > Project Settings > General > Your apps > Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin (Server-only - NEVER expose to browser)
# Get from Firebase Console > Project Settings > Service accounts > Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# Database (PostgreSQL - Supabase/Neon/Railway/Render)
# Format: postgresql://user:password@host:port/db?pgbouncer=true
# -----------------------------------------------------------------------------
DATABASE_URL=
# Direct/session connection used by Prisma migrations (use the Supabase Connect dialog).
DIRECT_URL=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Python CAD Backend URL (Deploy separately to Railway/Render/Fly.io)
# -----------------------------------------------------------------------------
CAD_SERVICE_URL=http://127.0.0.1:8000
CAD_SERVICE_TOKEN=

# Vercel Preview only: point to a separate feature-branch backend (never Production).
# Required when VERCEL_ENV=preview; Preview does not fall back to CAD_SERVICE_URL.
CAD_SERVICE_URL_PREVIEW=
CAD_SERVICE_TOKEN_PREVIEW=

# -----------------------------------------------------------------------------
# Admin Bootstrap (Server-only)
# A verified Firebase account with this exact email is promoted to ADMIN at sign-in.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# Cron Security (Server-only)
# Long random string for /api/cron/account-deletion endpoint
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Vercel Blob Storage (for file uploads)
# Get from Vercel Dashboard > Storage > Blob > Create Store
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
# Create a separate Vercel Blob store with access set to Private and copy its token here.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Razorpay (Phase 5+ - Billing)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create a Razorpay Subscriptions plan: INR 500, monthly, interval 1.
RAZORPAY_PLAN_ID=plan_replace_with_your_monthly_500_plan_id
# Set the same webhook signing secret in Razorpay Dashboard and this variable.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
