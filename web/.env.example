# =============================================================================
# Offline AI 3D Designer - Web Frontend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Client (Public - safe to expose in browser)
# Get from Firebase Console > Project Settings > General > Your apps > Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin (Server-only - NEVER expose to browser)
# Get from Firebase Console > Project Settings > Service accounts > Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# Database (PostgreSQL - Supabase/Neon/Railway/Render)
# Format: postgresql://user:password@host:port/db?pgbouncer=true
# -----------------------------------------------------------------------------
DATABASE_URL=
# Direct/session connection used by Prisma migrations (use the Supabase Connect dialog).
DIRECT_URL=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Python CAD Backend URL (Deploy separately to Railway/Render/Fly.io)
# -----------------------------------------------------------------------------
CAD_SERVICE_URL=http://127.0.0.1:8000
CAD_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Admin Bootstrap (Server-only)
# First user with this email becomes ADMIN automatically on signup
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# Cron Security (Server-only)
# Long random string for /api/cron/account-deletion endpoint
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Vercel Blob Storage (for file uploads)
# Get from Vercel Dashboard > Storage > Blob > Create Store
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Razorpay (Phase 5+ - Billing)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
