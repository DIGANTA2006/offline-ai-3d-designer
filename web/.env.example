# Public Firebase client configuration. These are Firebase web-app identifiers,
# not Firebase Admin private credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK: keep these server-only. Never prefix them with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PostgreSQL. Replace credentials/host before running migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/offline_ai_3d_designer?schema=public"

# Razorpay (Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Provider adapters (later phases); keep secrets on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
MESHY_API_KEY=
HUNYUAN3D_API_KEY=
TRELLIS_API_KEY=

# Python CAD service (Phase 3 onward)
CAD_SERVICE_URL=http://127.0.0.1:8000
INITIAL_ADMIN_EMAIL=
CRON_SECRET=
